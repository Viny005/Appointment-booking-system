generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InternalRole {
  ADMIN
  ADVISOR
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          InternalRole @default(ADVISOR)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  advisorProfile AdvisorProfile?
  canManageOwnServices Boolean @default(false)
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

enum ProfileStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum MeetingMode {
  IN_PERSON
  PHONE
  ONLINE
}

enum MeetingModePolicy {
  FIXED
  CLIENT_CHOICE
}

enum PhoneDirection {
  ADVISOR_CALLS_CLIENT
  CLIENT_CALLS_ADVISOR
}

model AdvisorProfile {
  id                String @id
  name              String @default("")
  title             String @default("")
  shortDescription  String @default("")
  notificationEmail String @default("")
  imageKey          String?
  status            ProfileStatus @default(DRAFT)
  userId            String? @unique
  user              User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  version           Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  services          Service[]
  outgoingRelations ProfileRelation[] @relation("RelationSource")
  incomingRelations ProfileRelation[] @relation("RelationTarget")
  @@index([status])
}

model Service {
  id                  String @id
  advisorProfileId    String
  advisorProfile      AdvisorProfile @relation(fields: [advisorProfileId], references: [id], onDelete: Restrict)
  name                String
  description         String
  durationMinutes     Int
  active              Boolean @default(false)
  meetingModePolicy   MeetingModePolicy
  allowedMeetingModes MeetingMode[]
  placeName           String?
  visitAddress        String?
  phoneDirection      PhoneDirection @default(ADVISOR_CALLS_CLIENT)
  advisorPhone        String?
  onlineUrl           String?
  onlineProvider      String?
  version             Int @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([advisorProfileId, active])
}

model ProfileRelation {
  id                String @id
  sourceProfileId   String
  targetProfileId   String
  sourceProfile     AdvisorProfile @relation("RelationSource", fields: [sourceProfileId], references: [id], onDelete: Restrict)
  targetProfile     AdvisorProfile @relation("RelationTarget", fields: [targetProfileId], references: [id], onDelete: Restrict)
  active            Boolean @default(true)
  proposedToClient  Boolean @default(true)
  defaultSelected   Boolean @default(false)
  clientCanRemove   Boolean @default(true)
  version           Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([sourceProfileId, targetProfileId])
  @@index([targetProfileId])
}
