generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InternalRole {
  ADMIN
  ADVISOR
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  role          InternalRole @default(ADVISOR)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  advisorProfile AdvisorProfile?
  canManageOwnServices Boolean @default(false)
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now())
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

enum ProfileStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum MeetingMode {
  IN_PERSON
  PHONE
  ONLINE
}

enum MeetingModePolicy {
  FIXED
  CLIENT_CHOICE
}

enum PhoneDirection {
  ADVISOR_CALLS_CLIENT
  CLIENT_CALLS_ADVISOR
}

model AdvisorProfile {
  id                String @id
  name              String @default("")
  title             String @default("")
  shortDescription  String @default("")
  notificationEmail String @default("")
  imageKey          String?
  status            ProfileStatus @default(DRAFT)
  userId            String? @unique
  user              User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  version           Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  services          Service[]
  appointmentParticipants AppointmentParticipant[]
  appointmentReservations AppointmentReservation[]
  availabilityVersion Int @default(0)
  weeklyAvailability WeeklyAvailability[]
  availabilityExceptions AvailabilityException[]
  outgoingRelations ProfileRelation[] @relation("RelationSource")
  incomingRelations ProfileRelation[] @relation("RelationTarget")
  @@index([status])
}

model Service {
  id                  String @id
  advisorProfileId    String
  advisorProfile      AdvisorProfile @relation(fields: [advisorProfileId], references: [id], onDelete: Restrict)
  name                String
  description         String
  durationMinutes     Int
  active              Boolean @default(false)
  meetingModePolicy   MeetingModePolicy
  allowedMeetingModes MeetingMode[]
  placeName           String?
  visitAddress        String?
  phoneDirection      PhoneDirection @default(ADVISOR_CALLS_CLIENT)
  advisorPhone        String?
  onlineUrl           String?
  onlineProvider      String?
  version             Int @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  appointments Appointment[]
  @@index([advisorProfileId, active])
}

model ProfileRelation {
  id                String @id
  sourceProfileId   String
  targetProfileId   String
  sourceProfile     AdvisorProfile @relation("RelationSource", fields: [sourceProfileId], references: [id], onDelete: Restrict)
  targetProfile     AdvisorProfile @relation("RelationTarget", fields: [targetProfileId], references: [id], onDelete: Restrict)
  active            Boolean @default(true)
  proposedToClient  Boolean @default(true)
  defaultSelected   Boolean @default(false)
  clientCanRemove   Boolean @default(true)
  version           Int @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([sourceProfileId, targetProfileId])
  @@index([targetProfileId])
}


enum AvailabilityExceptionType {
  BLOCK_DAY
  REPLACE_DAY
  ADD_INTERVAL
}

model WeeklyAvailability {
  id String @id
  advisorProfileId String
  advisorProfile AdvisorProfile @relation(fields: [advisorProfileId], references: [id], onDelete: Restrict)
  weekday Int
  startMinute Int
  endMinute Int
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([advisorProfileId, weekday])
}

model AvailabilityException {
  id String @id
  advisorProfileId String
  advisorProfile AdvisorProfile @relation(fields: [advisorProfileId], references: [id], onDelete: Restrict)
  type AvailabilityExceptionType
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  active Boolean @default(true)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  intervals AvailabilityExceptionInterval[]
  @@index([advisorProfileId, startDate, endDate])
}

model AvailabilityExceptionInterval {
  id String @id
  exceptionId String
  exception AvailabilityException @relation(fields: [exceptionId], references: [id], onDelete: Restrict)
  startMinute Int
  endMinute Int
  @@index([exceptionId])
}


enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ParticipantRole {
  PRIMARY
  ADDITIONAL
}

model Appointment {
  id String @id
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  status AppointmentStatus @default(CONFIRMED)
  timeZone String @default("Europe/Berlin")
  version Int @default(0)
  calendarUid String @unique
  calendarSequence Int @default(0)
  firstName String?
  lastName String?
  email String?
  phone String?
  address String?
  remarks String?
  serviceName String
  serviceDescription String
  durationMinutes Int
  meetingMode MeetingMode
  placeName String?
  visitAddress String?
  phoneDirection PhoneDirection?
  advisorPhone String?
  onlineUrl String?
  onlineProvider String?
  managementTokenHash String? @unique
  managementTokenExpiresAt DateTime? @db.Timestamptz(3)
  managementTokenRevokedAt DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  participants AppointmentParticipant[]
  guests AppointmentGuest[]
  reservations AppointmentReservation[]
  notifications Notification[]
  notificationEventNumber Int @default(0)
  reminderGeneration Int @default(0)
  @@index([status, startAt, endAt])
  @@index([serviceId])
}

model AppointmentParticipant {
  id String @id
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  advisorProfileId String
  advisorProfile AdvisorProfile @relation(fields: [advisorProfileId], references: [id], onDelete: Restrict)
  role ParticipantRole
  profileName String
  profileTitle String
  @@unique([appointmentId, advisorProfileId])
  @@index([advisorProfileId, appointmentId])
}

model AppointmentGuest {
  id String @id
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  email String
  @@unique([appointmentId, email])
}

// Derived resource occupancy mandated by ADR-007; never a second appointment history.
model AppointmentReservation {
  id String @id
  appointmentId String
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  advisorProfileId String
  advisorProfile AdvisorProfile @relation(fields: [advisorProfileId], references: [id], onDelete: Restrict)
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  @@unique([appointmentId, advisorProfileId])
}

model BookingDraft {
  id String @id
  capabilityHash String @unique
  payload Json
  version Int @default(0)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([expiresAt])
}

model BookingIdempotency {
  id String @id
  capabilityHash String
  commandKey String
  payloadHash String
  appointmentId String
  result Json
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now())
  @@unique([capabilityHash, commandKey])
  @@index([expiresAt])
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_CHANGED
  BOOKING_CANCELLED
  REMINDER
  PASSWORD_RESET
}
enum NotificationStatus {
  PENDING
  SENT
  FAILED
  SUPERSEDED
}
enum NotificationRecipient {
  CUSTOMER
  ADVISOR
  GUEST
  USER
}
model Notification {
  id String @id
  appointmentId String?
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  type NotificationType
  status NotificationStatus @default(PENDING)
  recipientCategory NotificationRecipient
  recipientEmail String
  advisorProfileId String?
  eventId String
  eventNumber Int
  appointmentVersion Int
  calendarSequence Int
  reminderGeneration Int?
  removedGuest Boolean @default(false)
  payload Json
  requiresSecret Boolean @default(false)
  secretCipher String?
  secretExpiresAt DateTime? @db.Timestamptz(3)
  secretTokenHash String?
  attempts Int @default(0)
  dueAt DateTime @db.Timestamptz(3)
  leaseToken String?
  leaseUntil DateTime? @db.Timestamptz(3)
  lastErrorCode String?
  sentAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([eventId, type, recipientEmail])
  @@index([status, dueAt, leaseUntil])
  @@index([appointmentId, recipientEmail, eventNumber])
  @@index([secretExpiresAt])
}
