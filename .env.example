# Local examples only. Copy to .env and generate independent random secrets.
DATABASE_URL=postgresql://appointment:local-development-only@127.0.0.1:5432/appointment_dev
POSTGRES_PASSWORD=local-development-only
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# SMTP adapter configuration; media storage follows in a later sprint.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=appointments@example.test
MEDIA_STORAGE_PATH=.local/media
# Optional seed inputs: supplied only when running the development seed.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
# Separate disposable DB, required only for explicit integration tests.
TEST_DATABASE_URL=postgresql://appointment:local-development-only@127.0.0.1:5432/appointment_test

# Notification worker: generate an independent key, never reuse BETTER_AUTH_SECRET.
OUTBOX_ENCRYPTION_KEY=
GUEST_PRIVACY_URL=http://localhost:3000/privacy/guests
# Set only after operator approval of the actual guest information in production.
PRIVACY_INFORMATION_APPROVED=false
MAIL_USER=
MAIL_PASSWORD=
# Development-only plaintext SMTP is restricted to loopback hosts.
MAIL_LOCAL_PLAINTEXT=true

# Development defaults, not statutory retention periods. Operator approval required in production.
RETENTION_ENDED_MONTHS=12
RETENTION_CANCELLED_MONTHS=6
RETENTION_AUDIT_MONTHS=12
RETENTION_DENIAL_DAYS=30
RETENTION_POLICY_APPROVED=false
RATE_AUTH_ACCOUNT_PER_MINUTE=5
RATE_AUTH_IP_PER_MINUTE=30
RATE_AUTH_GLOBAL_PER_MINUTE=300
RATE_PUBLIC_CAPABILITY_PER_MINUTE=60
RATE_PUBLIC_IP_PER_MINUTE=120
RATE_PUBLIC_GLOBAL_PER_MINUTE=1200
# Set only behind a network-isolated proxy that OVERWRITES this single-IP header.
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_PROXY_ONLY=false
# Enable only after HTTPS domain validation; no automatic includeSubDomains/preload.
HSTS_ENABLED=false
# Production media storage. Must be persistent and included in backup/restore procedures.
PROFILE_IMAGE_DIR=.local/profile-images
# Production readiness requires these operator approvals after real texts/policies are supplied.
# PRIVACY_INFORMATION_APPROVED=true
# RETENTION_POLICY_APPROVED=true
