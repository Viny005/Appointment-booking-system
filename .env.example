# Local examples only. Copy to .env and generate independent random secrets.
DATABASE_URL=postgresql://appointment:local-development-only@127.0.0.1:5432/appointment_dev
POSTGRES_PASSWORD=local-development-only
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# SMTP adapter configuration; media storage follows in a later sprint.
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=appointments@example.test
MEDIA_STORAGE_PATH=.local/media
# Optional seed inputs: supplied only when running the development seed.
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
# Separate disposable DB, required only for explicit integration tests.
TEST_DATABASE_URL=postgresql://appointment:local-development-only@127.0.0.1:5432/appointment_test

# Notification worker: generate an independent key, never reuse BETTER_AUTH_SECRET.
OUTBOX_ENCRYPTION_KEY=
GUEST_PRIVACY_URL=http://localhost:3000/privacy/guests
# Set only after operator approval of the actual guest information in production.
PRIVACY_INFORMATION_APPROVED=false
MAIL_USER=
MAIL_PASSWORD=
# Development-only plaintext SMTP is restricted to loopback hosts.
MAIL_LOCAL_PLAINTEXT=true
